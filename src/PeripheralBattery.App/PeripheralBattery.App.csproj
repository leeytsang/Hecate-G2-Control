<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>HecateG2Control</AssemblyName>
    <Product>HECATE G2 Control</Product>
    <Version>0.3.0</Version>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PeripheralBattery.Core\PeripheralBattery.Core.csproj" />
    <ProjectReference Include="..\PeripheralBattery.Windows\PeripheralBattery.Windows.csproj" />
  </ItemGroup>
  <Target Name="ExcludePdbsFromSingleFileBundle" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <FilesToBundle Remove="@(FilesToBundle)"
                     Condition="'%(FilesToBundle.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>