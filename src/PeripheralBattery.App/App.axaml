<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PeripheralBattery.App.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#22303C" />
      <Setter Property="BorderBrush" Value="#3A4A59" />
    </Style>
    <Style Selector="ToolTip">
      <Setter Property="Background" Value="#1A232C" />
      <Setter Property="Foreground" Value="#EEF3F8" />
      <Setter Property="BorderBrush" Value="#2C3A47" />
    </Style>
  </Application.Styles>
</Application>