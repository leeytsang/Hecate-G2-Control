<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PeripheralBattery.App.ViewModels"
             x:Class="PeripheralBattery.App.Controls.DeviceCard"
             x:DataType="vm:DeviceCardViewModel">
  <Border Background="#141A21"
          BorderBrush="#25303B"
          BorderThickness="1"
          CornerRadius="22"
          Padding="24">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
        <Border Width="56" Height="56" CornerRadius="18" Background="#1A242D">
          <Grid>
            <Viewbox Width="32" Height="32">
              <Path Data="M5,20 L5,15 C5,8.9 9.9,4 16,4 C22.1,4 27,8.9 27,15 L27,20 M5,19 C3.3,19 2,20.3 2,22 L2,25 C2,26.7 3.3,28 5,28 L8,28 L8,19 Z M27,19 C28.7,19 30,20.3 30,22 L30,25 C30,26.7 28.7,28 27,28 L24,28 L24,19 Z"
                    Stroke="{Binding AccentBrush}"
                    StrokeThickness="2.2"
                    StrokeLineCap="Round"
                    StrokeJoin="Round" />
            </Viewbox>
          </Grid>
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Foreground="#F4F7FA" TextWrapping="Wrap" />
          <TextBlock Text="{Binding KindLabel}" FontSize="12" Foreground="#7F8C9C" />
        </StackPanel>

        <Border Grid.Column="2" Background="#1A232C" CornerRadius="12" Padding="10,7" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse Width="7" Height="7" Fill="{Binding ConnectionBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" Foreground="#B8C3CF" />
          </StackPanel>
        </Border>
      </Grid>

      <Grid Grid.Row="1" VerticalAlignment="Center">
        <StackPanel IsVisible="{Binding HasBattery}" Spacing="11">
          <TextBlock Text="{Binding BatteryCaption}" FontSize="12" Foreground="#7F8C9C" />
          <TextBlock Text="{Binding BatteryText}" FontSize="58" FontWeight="Bold" Foreground="#F7FAFC" />
          <ProgressBar Minimum="0" Maximum="100"
                       Value="{Binding BatteryValue}"
                       Foreground="{Binding BatteryBrush}"
                       Background="#27313C"
                       Height="9" />
          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#8E9AAA" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel IsVisible="{Binding HasNoBattery}" Spacing="14">
          <TextBlock Text="--" FontSize="58" FontWeight="Bold" Foreground="#586473" />
          <Border Background="#1B232C" BorderBrush="#2A3541" BorderThickness="1" CornerRadius="12" Padding="12,9" HorizontalAlignment="Left">
            <TextBlock Text="{Binding UnavailableText}" FontSize="13" Foreground="#B6C1CD" />
          </Border>
          <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="#8491A1" TextWrapping="Wrap" MaxWidth="360" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
        <TextBlock Text="本地读取" FontSize="11" Foreground="#5E6A79" />
        <TextBlock Grid.Column="1" Text="无账号 · 无遥测" HorizontalAlignment="Right" FontSize="11" Foreground="#5E6A79" />
      </Grid>
    </Grid>
  </Border>
</UserControl>